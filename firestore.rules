rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{document=**} {
      allow read, write: if true;
    }
    match /drafts/{document=**} {
      allow read, write: if true;
    }
    match /blocked/{document=**} {
      allow read, write: if true;
    }
    match /blocked_items/{document=**} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
